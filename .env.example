# Copy to .env.local for local development (vercel dev reads it), and set the
# same variables in the Vercel dashboard for production/preview.

# Neon Postgres connection string (Vercel Marketplace -> Neon integration)
DATABASE_URL="postgres://user:password@host.neon.tech/dbname?sslmode=require"

# Password organizers use to sign in at the login screen
ADMIN_PASSWORD="change-me-to-something-long"
